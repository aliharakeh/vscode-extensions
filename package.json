{
  "name": "vscode-extensions",
  "private": true,
  "description": "Monorepo of personal VS Code extensions.",
  "workspaces": [
    "run-config"
  ],
  "scripts": {
    "predist": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\"",
    "prebuild": "npm run predist",
    "build": "npm run build --workspaces --if-present",
    "prebuild:run-config": "npm run predist",
    "build:run-config": "npm run build -w run-config"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
